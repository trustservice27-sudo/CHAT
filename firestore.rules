rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Health / connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Public messages - Open to all public users
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Public user presence - Open to all public users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
