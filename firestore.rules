rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      // Public room: anyone can read messages
      allow read: if true;

      // Anyone can post a message meeting strict schema validation
      allow create: if isValidId(messageId)
        && isValidMessage(request.resource.data);

      // Clearing messages allowed
      allow delete: if true;

      // Editing messages is forbidden
      allow update: if false;
    }
  }

  function isValidId(id) {
    return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
  }

  function isValidMessage(data) {
    return data.keys().hasAll(['userId', 'displayName', 'text', 'createdAt'])
      && data.keys().hasOnly(['userId', 'displayName', 'text', 'createdAt', 'photoURL'])
      && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
      && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
      && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
      && data.createdAt == request.time
      && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
  }
}
