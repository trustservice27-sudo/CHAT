rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Public messages in online Firestore database
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId)
        && isValidMessage(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    // Online users / profiles saved in online database
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId)
        && isValidUser(request.resource.data);
      allow delete: if true;
    }
  }

  function isValidId(id) {
    return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
  }

  function isValidMessage(data) {
    return data.keys().hasAll(['userId', 'displayName', 'text', 'createdAt'])
      && data.keys().hasOnly(['userId', 'displayName', 'text', 'createdAt', 'photoURL', 'avatarUrl'])
      && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
      && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
      && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
      && data.createdAt == request.time
      && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
      && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000));
  }

  function isValidUser(data) {
    return data.keys().hasAll(['userId', 'displayName', 'avatarUrl'])
      && data.keys().hasOnly(['userId', 'displayName', 'avatarUrl', 'avatarStyle', 'avatarSeed', 'lastActive', 'createdAt'])
      && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
      && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
      && data.avatarUrl is string && data.avatarUrl.size() > 0 && data.avatarUrl.size() <= 1000;
  }
}
